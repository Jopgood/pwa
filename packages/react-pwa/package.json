{
  "name": "@jop/react-pwa",
  "version": "0.0.1",
  "description": "React adapter for @jop/pwa-core",
  "author": "Jopgood",
  "license": "MIT",
  "keywords": [
    "react",
    "pwa",
    "push-notifications",
    "hooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@jop/pwa-core": "workspace:*",
    "@tanstack/store": "catalog:prod",
    "@tanstack/react-store": "catalog:prod"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "catalog:peer",
    "@types/react-dom": "catalog:peer",
    "react": "catalog:peer",
    "react-dom": "catalog:peer"
  }
}
