{
  "name": "jop-pwa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "tsdown",
    "build:core": "tsdown -F @jopgood/pwa-core",
    "build:react": "tsdown -F @jopgood/react-pwa",
    "dev": "tsdown --watch",
    "dev:web": "pnpm dev --filter apps/web",
    "clean": "pnpm -r exec rm -rf dist",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:types": "turbo run test:types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "changes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline --no-merges",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm format",
    "changeset:publish": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "catalog:dev",
    "happy-dom": "catalog:dev",
    "prettier": "catalog:dev",
    "prettier-plugin-tailwindcss": "catalog:dev",
    "publint": "^0.3.18",
    "tsdown": "catalog:dev",
    "turbo": "^2.9.12",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": ">=20"
  }
}
